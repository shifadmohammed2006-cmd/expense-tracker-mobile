# Copy this file to .env and fill it in. Never commit .env.

# MongoDB Atlas connection string (Atlas -> Connect -> Drivers).
# Replace <password> and add a database name (expense-tracker) before the "?".
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/expense-tracker?retryWrites=true&w=majority

# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

PORT=5000
